# ==============================================================================
# Distributed Transaction Coordinator (DTC) — Environment Configuration
# ==============================================================================

# PostgreSQL Shared Instance & Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=coordinator_db,inventory_db,payment_db

# Per-Service Database Names
COORDINATOR_DB_NAME=coordinator_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db

# Redis Broker & Fast-Path Cache
REDIS_URL=redis://redis:6379/0

# Microservice Inter-Service Network Resolution
INVENTORY_SERVICE_URL=http://inventory:8000
PAYMENT_SERVICE_URL=http://payment:8001
COORDINATOR_SERVICE_URL=http://coordinator:8002

# Application Settings
DEBUG=True
ALLOWED_HOSTS=*
SECRET_KEY=django-insecure-dtc-development-secret-key-change-in-production
REQUEST_TIMEOUT=5
