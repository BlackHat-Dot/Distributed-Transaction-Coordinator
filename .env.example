
# Local Development Environment


# --- Shared PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_MULTIPLE_DATABASES=coordinator_db,inventory_db,payment_db

# --- Microservice Database Names ---
COORDINATOR_DB_NAME=coordinator_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db

# --- Redis Message Broker & Cache ---
REDIS_URL=redis://redis:6379/0

# --- Inter-Service Routing (Docker Container DNS) ---
INVENTORY_SERVICE_URL=http://inventory:8000
PAYMENT_SERVICE_URL=http://payment:8001

# --- Application Security & Core Settings ---
# In development, DEBUG=True enables auto-mocked OTPs (no external email needed).
# In production, DEBUG=False strictly requires unique SECRET_KEY and INTERNAL_SERVICE_KEY.
# Set DEBUG=True only for local development on your own machine
DEBUG=False
ALLOWED_HOSTS=*
SECRET_KEY=django-insecure-dtc-development-secret-key-change-in-production
INTERNAL_SERVICE_KEY=dtc-internal-coordinator-secret-key-2026
REQUEST_TIMEOUT=5

# --- Distributed Saga Recovery & Quota Settings ---
RECOVERY_THRESHOLD_SECONDS=60
RECOVERY_MIN_THRESHOLD_SECONDS=30
MAX_ACTOR_HOLDS=10
ENABLE_TEST_PAYMENT_FAILURE=True

# --- Email OTP Service (Optional in Local Dev: leave empty for console OTPs) ---
RESEND_API_KEY=

