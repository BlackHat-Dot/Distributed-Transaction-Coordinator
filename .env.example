POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=coordinator_db,inventory_db,payment_db

COORDINATOR_DB_NAME=coordinator_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db

REDIS_URL=redis://redis:6379/0

INVENTORY_SERVICE_URL=http://inventory:8000
PAYMENT_SERVICE_URL=http://payment:8001
COORDINATOR_SERVICE_URL=http://coordinator:8002

# Application Environment Settings
# NOTE FOR PRODUCTION:
# When DEBUG=False, SECRET_KEY and ALLOWED_HOSTS must be explicitly configured!
# A placeholder SECRET_KEY starting with 'django-insecure' will be rejected.
DEBUG=True
ALLOWED_HOSTS=*
SECRET_KEY=django-insecure-dtc-development-secret-key-change-in-production
REQUEST_TIMEOUT=5

# Email Settings (Optional: leave empty to log OTP emails to console in development)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
